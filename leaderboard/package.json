{
  "name": "keep-hands-leaderboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:migrate:local": "wrangler d1 migrations apply keep-hands --local",
    "db:migrate:remote": "wrangler d1 migrations apply keep-hands --remote",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  }
}
